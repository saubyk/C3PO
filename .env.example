# =============================================================================
# C3PO local config. Copy this file to `.env` and fill in the values below.
# `.env` is gitignored. The token is read server-side only and never sent to
# the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# GITHUB_TOKEN — GitHub Personal Access Token (classic)
# -----------------------------------------------------------------------------
# Create one at: https://github.com/settings/tokens/new
#
# Recommended settings on the creation page:
#   Note:        c3po-local         (or anything memorable)
#   Expiration:  90 days            (GitHub default; renew when it lapses)
#
# Scopes to tick (classic PAT):
#   [x] read:project   Required. Projects v2 fields (Status, Priority, Size,
#                      items) only exist in GraphQL behind this scope.
#   [x] repo           Required if your project references PRIVATE repos.
#                      Use `public_repo` instead if every repo is public.
#   [x] read:org       Required if GITHUB_OWNER below is an organization.
#                      Skip if GITHUB_OWNER is your personal handle.
#   [x] read:user      Optional. Safe to include.
#
# Do NOT tick any `write:*`, `delete:*`, or `admin:*` scopes — C3PO is
# strictly read-only against GitHub.
#
# SSO note: if your org enforces SAML SSO, after creating the token click
# "Configure SSO" next to it on https://github.com/settings/tokens and
# authorize it for that org. Otherwise org-scoped queries will 401.
#
# Milestone-1 smoke test only needs a valid token (any scopes) — the health
# check just resolves `viewer { login }`. The scopes above start mattering
# from Milestone 2 onward.
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
# GITHUB_OWNER — login of the user or organization that owns the Project board
# -----------------------------------------------------------------------------
# Examples:
#   GITHUB_OWNER=octocat            (a personal account)
#   GITHUB_OWNER=my-company         (an organization)
GITHUB_OWNER=
